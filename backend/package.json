{
  "name": "@physio/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@physio/contracts": "workspace:*",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "@vercel/express": "^1.1.0",
    "dotenv": "^17.2.2",
    "express": "^5.2.1",
    "pg": "^8.16.3",
    "supertest": "^7.2.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.0",
    "prisma": "7.10.0",
    "tsx": "^4.20.6",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^7.2.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
