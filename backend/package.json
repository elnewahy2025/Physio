{
  "name": "@physio/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@physio/contracts": "workspace:*",
    "@prisma/client": "7.10.0",
    "express": "^5.2.1",
    "supertest": "^7.2.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.0",
    "prisma": "7.10.0",
    "tsx": "^4.20.6",
    "@types/supertest": "^7.2.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
